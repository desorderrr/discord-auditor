# Token do bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=cola-o-token-aqui

# ID da aplicação (Developer Portal > General Information)
CLIENT_ID=123456789012345678

# ID do servidor a auditar (clique direito no servidor com o modo dev ligado > Copiar ID)
GUILD_ID=123456789012345678

# Opcional: registar os slash commands automaticamente ao iniciar (true/false)
REGISTER_ON_START=true

# Opcional: cargos (IDs separados por vírgula) autorizados a usar /audit e /fix.
# Se vazio, qualquer membro com a permissão "Gerir servidor" pode usar.
AUDIT_ROLE_IDS=

# Opcional: usar o intent privilegiado "Server Members".
# Se estiver false (ou se o portal não o tiver ativado), o bot funciona na mesma,
# mas salta as verificações que dependem da lista de membros.
ENABLE_MEMBERS_INTENT=true

# Opcional: buscar a lista completa de membros (necessário para detetar cargos vazios).
# Fica mais lento em servidores grandes. true/false
FETCH_MEMBERS=true

# Opcional: dias sem mensagens para considerar um canal "morto"
DEAD_CHANNEL_DAYS=90

# Opcional: webhook do Discord para as novidades do FitGirl Repacks
# (cria em Canal > Integrações > Webhooks). Só é preciso no Pi.
FITGIRL_WEBHOOK_URL=
